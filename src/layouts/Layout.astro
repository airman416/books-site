---
import '../styles/global.css';
import PostHog from '../components/posthog.astro';
import siteSettings from '../data/siteSettings.json';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = siteSettings.site.description,
  image = '/images/og-image.png'
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content={siteSettings.site.title} />
    <meta name="theme-color" content="#06402B" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Open Graph / Facebook Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteSettings.site.title} />
    <meta property="og:site_name" content={siteSettings.site.title} />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteSettings.site.twitter} />
    <meta name="twitter:creator" content={siteSettings.site.twitter} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={siteSettings.site.title} />
    
    <!-- Schema.org Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Armaan Agrawal",
      "description": "I build software and speak about what I learn along the way.",
      "url": "https://armaanagrawal.com",
      "image": {
        "@type": "ImageObject",
        "url": "https://armaanagrawal.com/images/og-image.png",
        "width": 1200,
        "height": 630
      },
      "sameAs": [
        "https://x.com/airman416",
        "https://linkedin.com/in/agr1",
        "https://tiktok.com/@armaanagrawal5"
      ],
      "jobTitle": "Software Developer",
      "worksFor": {
        "@type": "Organization",
        "name": "Armaan Agrawal"
      },
      "knowsAbout": ["Startups", "Productivity", "Business", "Technology"]
    }
    </script>
    
    <!-- Adobe Typekit Fonts -->
    <link rel="stylesheet" href="https://use.typekit.net/kyi7jre.css" />
    
    <title>{title}</title>
    
    <!-- PostHog Analytics -->
    <PostHog />
    
    <!-- Netlify Identity Widget -->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  </head>
  <body>
    <!-- Initials in Top Left -->
    <div class="fixed top-6 left-6 z-50">
      <a href="/" id="nav-initials" class="text-2xl font-bold text-[#161717] hover:opacity-70">
        {siteSettings.site.initials}
      </a>
    </div>
    
    <slot />
    
    <!-- Netlify Identity Redirect Handler -->
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", user => {
          if (!user) {
            window.netlifyIdentity.on("login", () => {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
    
    <!-- Navigation Initials Color Adapter -->
    <script>
      import '../scripts/navColorAdapter.js';
    </script>
    
    <!-- ConvertKit Inline Form -->
    <script is:inline>
      (function() {
        const formContainer = document.getElementById('newsletter-form');
        if (!formContainer) return;
        
        // Create the inline form HTML
        const formHTML = `
          <form action="https://app.kit.com/forms/8646838/subscriptions" class="newsletter-form" method="post">
            <div class="form-row">
              <input 
                type="email" 
                name="email_address" 
                placeholder="Enter your email" 
                required 
                class="email-input"
              />
              <button type="submit" class="submit-button">Subscribe</button>
            </div>
          </form>
        `;
        
        formContainer.innerHTML = formHTML;
      })();
    </script>
  </body>
</html>
