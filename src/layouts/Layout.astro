---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Books — Armaan Agrawal",
  description = "Books that shaped how I think — with notes on why they mattered."
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#06402B" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <link rel="stylesheet" href="https://use.typekit.net/kyi7jre.css" />
    <title>{title}</title>
  </head>
  <body>
    <nav class="fixed top-6 left-6 z-50">
      <a href="https://armaanagrawal.com" class="text-2xl font-bold" style="color: #161717; text-decoration: none;">A.A.</a>
    </nav>
    <slot />
    <footer class="py-12 text-center" style="color: var(--gray-500); font-size: 0.875rem;">
      Armaan Agrawal
    </footer>
  </body>
</html>
