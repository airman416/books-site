---
import '../styles/global.css';
import PostHog from '../components/posthog.astro';
import siteSettings from '../data/siteSettings.json';

interface Props {
  title: string;
  description?: string;
}

const { title, description = siteSettings.site.description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={siteSettings.site.twitter} />
    
    <!-- Adobe Typekit Fonts -->
    <link rel="stylesheet" href="https://use.typekit.net/kyi7jre.css" />
    
    <title>{title}</title>
    
    <!-- PostHog Analytics -->
    <PostHog />
    
    <!-- Netlify Identity Widget -->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  </head>
  <body>
    <!-- Initials in Top Left -->
    <div class="fixed top-6 left-6 z-50">
      <a href="/" id="nav-initials" class="text-2xl font-bold text-black hover:opacity-70">
        {siteSettings.site.initials}
      </a>
    </div>
    
    <slot />
    
    <!-- Netlify Identity Redirect Handler -->
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", user => {
          if (!user) {
            window.netlifyIdentity.on("login", () => {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
    
    <!-- Navigation Initials Color Adapter -->
    <script>
      import '../scripts/navColorAdapter.js';
    </script>
    
    <!-- Footer Navigation -->
    <footer class="bg-black text-white py-12 mt-24 footer-futura">
      <div class="max-w-6xl mx-auto px-6">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
          <!-- Name/Brand -->
          <div>
            <h3 class="text-2xl font-bold mb-2 keep-default-font">{siteSettings.footer.brandName}</h3>
            <p class="text-sm opacity-80">{siteSettings.footer.tagline}</p>
          </div>
          
          <!-- Navigation Links -->
          <nav class="flex flex-col md:flex-row gap-6 text-sm">
            {siteSettings.footer.navigation.map((link: any) => (
              <a href={link.url} class="text-white opacity-80 hover:opacity-100">{link.label}</a>
            ))}
          </nav>
          
          <!-- Social Links & Resume -->
          <div class="flex flex-col gap-4">
            <div class="flex gap-6 text-sm">
              {siteSettings.footer.socialLinks.map((link: any) => (
                <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-white opacity-80 hover:opacity-100">{link.label}</a>
              ))}
            </div>
            <a href={siteSettings.footer.resumeLink.file} download class="text-sm text-white opacity-80 hover:opacity-100 underline">{siteSettings.footer.resumeLink.label}</a>
          </div>
        </div>
        
        <div class="mt-8 pt-8 border-t border-white border-opacity-20 text-sm opacity-60 text-center">
          <p>&copy; {new Date().getFullYear()} {siteSettings.footer.copyrightName}. All rights reserved.</p>
        </div>
      </div>
    </footer>
    
    <style>
      .footer-futura {
        font-family: "futura-pt", sans-serif;
        font-weight: 300;
        font-style: normal;
      }
      
      .keep-default-font {
        font-family: inherit !important;
      }
    </style>
  </body>
</html>
