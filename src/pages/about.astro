---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import aboutPage from '../data/aboutPage.json';
---

<Layout title={`${aboutPage.header.title} - ${aboutPage.header.title.split(' ')[1] || 'About'}`} description={aboutPage.header.subtitle}>
  <main class="min-h-screen py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <!-- Header with Image -->
      <div class="grid md:grid-cols-5 gap-12 mb-16">
        <div class="md:col-span-3 space-y-6">
          <h1 class="text-5xl md:text-6xl font-bold">{aboutPage.header.title}</h1>
          <p class="text-xl text-gray-700">
            {aboutPage.header.subtitle}
          </p>
        </div>
        <div class="md:col-span-2">
          <Image 
            src={aboutPage.header.image} 
            alt={aboutPage.header.imageAlt}
            width={600}
            height={600}
            class="w-full h-auto"
            loading="eager"
          />
        </div>
      </div>

      <!-- Main Content -->
      <div class="space-y-12 text-lg text-gray-700">
        {aboutPage.sections.map((section: any) => (
          <section class="space-y-4">
            <h2 class="text-3xl font-bold text-black">{section.heading}</h2>
            {section.paragraphs && section.paragraphs.map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
            {section.bulletPoints && (
              <ul class="list-none space-y-3 pl-6 border-l-4 border-[#06402B]">
                {section.bulletPoints.map((point: string) => (
                  <li>{point}</li>
                ))}
              </ul>
            )}
            {section.afterBullets && section.afterBullets.map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
            {section.socialLinks && (
              <div class="flex flex-col sm:flex-row gap-6 pt-4">
                {section.socialLinks.map((link: any) => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer" 
                     class="text-lg underline">{link.label}</a>
                ))}
              </div>
            )}
          </section>
        ))}
      </div>

      <!-- Resume Download -->
      <div class="mt-16 pt-12 border-t border-gray-200">
        <a href={aboutPage.resumeSection.file} download class="bg-[#06402B] text-white px-8 py-4 text-lg font-medium inline-block">
          {aboutPage.resumeSection.buttonText}
        </a>
      </div>
    </div>
  </main>
</Layout>
