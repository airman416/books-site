---
import Layout from '../layouts/Layout.astro';
import aboutPage from '../data/aboutPage.json';
---

<Layout title={`${aboutPage.header.title} - ${aboutPage.header.title.split(' ')[1] || 'About'}`} description={aboutPage.header.subtitle}>
  <main class="w-full max-w-4xl mx-auto px-8 py-20">
    <!-- Header -->
    <div class="mb-16">
      <h1 class="text-2xl md:text-3xl font-bold mb-6">{aboutPage.header.title}</h1>
      <p class="text-base text-gray-700">
        {aboutPage.header.subtitle}
      </p>
    </div>

    <!-- Main Content -->
    <div class="space-y-8 text-base text-gray-700">
      {aboutPage.sections.map((section: any) => (
        <section class="space-y-4">
          <h2 class="text-lg text-black">{section.heading}</h2>
          {section.paragraphs && section.paragraphs.map((paragraph: string) => (
            <p>{paragraph}</p>
          ))}
          {section.bulletPoints && (
            <ul class="list-none space-y-2 pl-4">
              {section.bulletPoints.map((point: string) => (
                <li>• {point}</li>
              ))}
            </ul>
          )}
          {section.afterBullets && section.afterBullets.map((paragraph: string) => (
            <p>{paragraph}</p>
          ))}
          {section.socialLinks && (
            <div class="flex flex-wrap gap-6 pt-4">
              {section.socialLinks.map((link: any) => (
                <a href={link.url} target="_blank" rel="noopener noreferrer" 
                   class="underline">{link.label}</a>
              ))}
            </div>
          )}
        </section>
      ))}
    </div>

    <!-- Resume Download -->
    <div class="mt-12 pt-8 border-t border-gray-200">
      <a href={aboutPage.resumeSection.file} download class="underline text-base">
        {aboutPage.resumeSection.buttonText}
      </a>
    </div>
  </main>
</Layout>
