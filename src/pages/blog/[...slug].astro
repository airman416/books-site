---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import homePage from '../../data/homePage.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  // Only generate pages for published posts
  const publishedPosts = posts.filter(post => post.data.published !== false);
  return publishedPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Get more essays configuration from the current post
const moreEssaysConfig = post.data.moreEssays;

// Generate schema.org data for the blog post
const blogPostSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description || post.data.title,
  "image": post.data.image ? `https://armaanagrawal.com${post.data.image}` : "https://armaanagrawal.com/images/og-image.png",
  "author": {
    "@type": "Person",
    "name": post.data.author || "Armaan Agrawal",
    "url": "https://armaanagrawal.com"
  },
  "publisher": {
    "@type": "Person",
    "name": "Armaan Agrawal",
    "url": "https://armaanagrawal.com"
  },
  "datePublished": post.data.date.toISOString(),
  "dateModified": post.data.date.toISOString(),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://armaanagrawal.com/blog/${post.slug}`
  },
  "url": `https://armaanagrawal.com/blog/${post.slug}`,
  "articleSection": post.data.topic || "General",
  "keywords": post.data.tags || []
};
---

<Layout title={`${post.data.title} - Armaan Agrawal`} description={post.data.description || post.data.title}>
  <!-- Schema.org Structured Data for Blog Post -->
  <script type="application/ld+json" set:html={JSON.stringify(blogPostSchema)}></script>
  
  <main class="w-full max-w-4xl mx-auto px-8 py-20">
    <article>
      <!-- Back Link -->
      <div class="mb-8">
        <a href="/" class="underline">← Back</a>
      </div>

      <!-- Article Header -->
      <header class="mb-12">
        <h1 class="text-2xl md:text-3xl font-bold mb-4">
          {post.data.title}
        </h1>
        
        <div class="text-xs text-gray-500">
          {post.data.date.toLocaleDateString('en-US', { 
            year: 'numeric', 
            month: 'long', 
            day: 'numeric' 
          })}
        </div>
      </header>

      <!-- Article Content -->
      <div class="prose prose-lg max-w-none">
        <Content />
      </div>

      <!-- More Essays -->
      {moreEssaysConfig && moreEssaysConfig.links && moreEssaysConfig.links.length > 0 && (
        <section class="mt-16 pt-8 border-t border-gray-200">
          <h2 class="text-lg font-bold mb-4">{moreEssaysConfig.heading || "More essays"}</h2>
          <ul class="list-disc pl-6 space-y-2">
            {moreEssaysConfig.links.map((link: { title: string; url: string }) => (
              <li>
                <a href={link.url} class="text-base underline decoration-[#06402B]/30 decoration-1 underline-offset-4 hover:text-[#06402B] hover:decoration-[#06402B]">
                  {link.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Newsletter -->
      <section class="mt-12 pt-8 border-t border-gray-200">
        <p class="text-sm text-gray-700 mb-2">
          {homePage.newsletter.description}
        </p>
        <div id="newsletter-form"></div>
      </section>
    </article>
  </main>
</Layout>

<style is:global>
  /* Prose styling for blog content */
  .prose {
    color: #161717;
    max-width: none;
  }

  /* Headings */
  .prose h1 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .prose h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .prose h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .prose h4 {
    font-size: 1rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .prose h5 {
    font-size: 0.95rem;
    font-weight: 400;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .prose h6 {
    font-size: 0.9rem;
    font-weight: 400;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  /* Paragraphs */
  .prose p {
    margin-bottom: 1.5rem;
    line-height: 1.8;
    font-size: 1rem;
  }

  /* Lists */
  .prose ul, .prose ol {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
    line-height: 1.8;
  }

  .prose ul {
    list-style-type: disc;
  }

  .prose ol {
    list-style-type: decimal;
  }

  .prose li {
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }

  .prose li > ul,
  .prose li > ol {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  /* Links */
  .prose a {
    color: #06402B;
    text-decoration: underline;
    text-decoration-color: #06402B;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: opacity 0.2s ease;
  }

  .prose a:hover {
    opacity: 0.7;
  }

  /* Strong and emphasis */
  .prose strong {
    font-weight: 700;
  }

  .prose em {
    font-style: italic;
  }

  /* Code */
  .prose code {
    background-color: #f3f4f6;
    color: #1f2937;
    padding: 0.2rem 0.4rem;
    font-size: 0.9em;
    font-family: 'Courier New', monospace;
  }

  .prose pre {
    background-color: #1f2937;
    color: #f3f4f6;
    padding: 1.5rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    margin-top: 1.5rem;
    line-height: 1.6;
  }

  .prose pre code {
    background-color: transparent;
    color: inherit;
    padding: 0;
    font-size: 0.9rem;
  }

  /* Blockquotes */
  .prose blockquote {
    border-left: 4px solid #06402B;
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: #4b5563;
    font-size: 1rem;
  }

  .prose blockquote p {
    margin-bottom: 1rem;
  }

  /* Images */
  .prose img {
    margin: 2rem auto;
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* Horizontal rules */
  .prose hr {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin: 3rem 0;
  }

  /* Tables */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
  }

  .prose table th {
    background-color: #f9fafb;
    font-weight: 700;
    padding: 0.75rem 1rem;
    text-align: left;
    border: 1px solid #e5e7eb;
  }

  .prose table td {
    padding: 0.75rem 1rem;
    border: 1px solid #e5e7eb;
  }

  .prose table tr:nth-child(even) {
    background-color: #f9fafb;
  }
</style>
