---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Blog - Armaan Agrawal" description="Read Armaan Agrawal's thoughts on startups, productivity, business, and technology.">
  <main class="w-full max-w-4xl mx-auto px-8 py-20">
    <!-- Header -->
    <div class="mb-16">
      <h1 class="text-5xl md:text-6xl font-bold mb-6">Blog</h1>
      <p class="text-xl text-gray-700">
        Writing about startups, productivity, and technology.
      </p>
    </div>

    <!-- Blog Posts -->
    <div class="space-y-8">
      {sortedPosts.map((post) => (
        <article class="border-b border-gray-200 pb-6">
          <a href={`/blog/${post.slug}`} class="block group">
            <div class="flex items-baseline gap-3 mb-2">
              <h2 class="text-2xl group-hover:text-[#06402B]">
                {post.data.title}
              </h2>
              <span class="text-sm text-gray-500 flex-shrink-0">
                {post.data.date.toLocaleDateString('en-US', { 
                  month: 'short', 
                  day: 'numeric',
                  year: 'numeric' 
                })}
              </span>
            </div>
            <p class="text-gray-700">
              {post.data.description}
            </p>
          </a>
        </article>
      ))}
    </div>

    {sortedPosts.length === 0 && (
      <div class="text-center py-12 text-gray-600">
        <p class="text-xl">No posts yet. Check back soon!</p>
      </div>
    )}
  </main>
</Layout>
