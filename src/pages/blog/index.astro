---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Blog - Armaan Agrawal" description="Read Armaan Agrawal's thoughts on startups, productivity, business, and technology.">
  <main class="min-h-screen py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="mb-16">
        <h1 class="text-5xl md:text-6xl font-bold mb-6">Blog</h1>
        <p class="text-xl text-gray-700">
          Writing about startups, productivity, and technology. 
          Lessons from building, failing, and learning.
        </p>
      </div>

      <!-- Blog Posts -->
      <div class="space-y-16">
        {sortedPosts.map((post) => (
          <article class="border-b border-gray-200 pb-12">
            <div class="space-y-4">
              <div class="text-sm text-gray-600">
                {post.data.date.toLocaleDateString('en-US', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric' 
                })}
              </div>
              
              <h2 class="text-3xl md:text-4xl font-bold">
                <a href={`/blog/${post.slug}`} class="hover:underline">
                  {post.data.title}
                </a>
              </h2>
              
              <p class="text-lg text-gray-700">
                {post.data.description}
              </p>
              
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex gap-2 flex-wrap">
                  {post.data.tags.map((tag) => (
                    <span class="text-sm bg-[#06402B] text-white px-3 py-1">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
              
              <a href={`/blog/${post.slug}`} class="inline-block text-lg underline">
                Read more →
              </a>
            </div>
          </article>
        ))}
      </div>

      {sortedPosts.length === 0 && (
        <div class="text-center py-12 text-gray-600">
          <p class="text-xl">No posts yet. Check back soon!</p>
        </div>
      )}
    </div>
  </main>
</Layout>
