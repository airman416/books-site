---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import homePage from '../data/homePage.json';

const allPosts = await getCollection('blog');
const recentPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
---

<Layout title={`${homePage.hero.title} - Home`} description={homePage.hero.subtitle}>
  <!-- Hero Section -->
  <section class="min-h-screen flex items-center justify-center px-6 py-24">
    <div class="max-w-6xl w-full grid md:grid-cols-2 gap-16 items-center">
      <!-- Hero Content -->
      <div class="space-y-8">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold leading-tight">
          {homePage.hero.title}
        </h1>
        <p class="text-xl md:text-2xl text-gray-800">
          {homePage.hero.subtitle}
        </p>
        <p class="text-lg text-gray-700">
          {homePage.hero.description}
        </p>
        <div class="flex gap-4 pt-4">
          <a href={homePage.hero.primaryButton.url} class="bg-[#06402B] text-white px-8 py-4 text-lg font-medium">
            {homePage.hero.primaryButton.text}
          </a>
          <a href={homePage.hero.secondaryButton.url} class="border-2 border-[#06402B] text-black px-8 py-4 text-lg font-medium">
            {homePage.hero.secondaryButton.text}
          </a>
        </div>
      </div>
      
      <!-- Hero Image -->
      <div class="order-first md:order-last">
        <Image 
          src={homePage.hero.image} 
          alt={homePage.hero.imageAlt}
          width={800}
          height={800}
          class="w-full h-auto"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- About Preview Section -->
  <section class="py-24 px-6 bg-gray-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-4xl md:text-5xl font-bold mb-8">{homePage.aboutPreview.heading}</h2>
      <div class="space-y-6 text-lg text-gray-700">
        {homePage.aboutPreview.paragraphs.map((paragraph: string) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <div class="mt-12">
        <a href={homePage.aboutPreview.link.url} class="text-lg underline">{homePage.aboutPreview.link.text}</a>
      </div>
    </div>
  </section>

  <!-- Featured Work -->
  <section class="py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-4xl md:text-5xl font-bold mb-12">{homePage.featuredWork.heading}</h2>
      <div class="space-y-8">
        {homePage.featuredWork.workItems.map((item: any) => (
          <div class="border-b border-gray-200 pb-8">
            <h3 class="text-2xl font-bold mb-2">{item.title}</h3>
            <p class="text-gray-700">
              {item.description}
            </p>
          </div>
        ))}
        
        <!-- Latest Writing -->
        <div>
          <h3 class="text-2xl font-bold mb-4">{homePage.featuredWork.latestWriting.heading}</h3>
          <div class="space-y-4">
            {recentPosts.map((post) => (
              <a href={`/blog/${post.slug}`} class="flex gap-4 items-center group hover:opacity-70 transition-opacity">
                <Image 
                  src={post.data.image || homePage.hero.image}
                  alt={post.data.title}
                  width={80}
                  height={80}
                  class="w-20 h-20 object-cover flex-shrink-0"
                  loading="lazy"
                />
                <div class="flex-1">
                  <h4 class="font-bold text-lg group-hover:text-[#06402B] transition-colors">{post.data.title}</h4>
                  <p class="text-sm text-gray-600">
                    {post.data.date.toLocaleDateString('en-US', { 
                      year: 'numeric', 
                      month: 'long', 
                      day: 'numeric' 
                    })}
                  </p>
                </div>
              </a>
            ))}
          </div>
          <a href={homePage.featuredWork.latestWriting.viewAllLink.url} class="inline-block text-lg underline mt-4">{homePage.featuredWork.latestWriting.viewAllLink.text}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section id="connect" class="py-24 px-6 bg-[#06402B] text-white">
    <div class="max-w-4xl mx-auto text-center space-y-8">
      <h2 class="text-4xl md:text-5xl font-bold">{homePage.cta.heading}</h2>
      <p class="text-xl">
        {homePage.cta.description}
      </p>
      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center pt-4">
        {homePage.cta.links.map((link: any) => (
          link.url ? (
            <a href={link.url} target="_blank" rel="noopener noreferrer" 
               class="text-lg text-white underline">{link.label}</a>
          ) : (
            <a href={link.file} download 
               class="text-lg text-white underline">{link.label}</a>
          )
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Scroll animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  section {
    animation: fadeInUp 0.8s ease-out;
  }
</style>