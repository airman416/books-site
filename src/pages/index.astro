---
import Layout from '../layouts/Layout.astro';
import { books } from '../data/books';

const allTags = ['memoir', 'philosophy', 'stoicism', 'business', 'product', 'advertising'];
---

<Layout title="Books — Armaan Agrawal">
  <main class="max-w-4xl mx-auto px-8 py-20">
    <header class="mb-12">
      <p class="uppercase tracking-widest mb-3" style="font-size: 0.75rem; color: var(--gray-500);">Reading list</p>
      <h1 class="mb-4" style="font-size: 2.5rem; font-weight: 700; color: var(--black);">Books I recommend</h1>
      <p style="color: var(--gray-700); font-size: 1.0625rem;">Books that shaped how I think — with notes on why they mattered.</p>
    </header>

    <div class="mb-10 flex flex-wrap gap-2">
      <button class="filter-pill active" data-tag="all">All</button>
      {allTags.map(tag => (
        <button class="filter-pill" data-tag={tag}>{tag}</button>
      ))}
    </div>

    <ul class="book-list" style="list-style: none; padding: 0; margin: 0;">
      {books.map(book => (
        <li
          class="book-card"
          data-tags={book.tags.join(',')}
          style="border-bottom: 1px solid var(--gray-200);"
        >
          <a href={`/books/${book.slug}`} class="book-card-link">
            <div class="book-cover-wrap">
              <img
                src={book.cover}
                alt={book.title}
                class="book-cover"
                loading="lazy"
              />
            </div>
            <div class="book-info">
              <p class="book-tags">
                {book.tags.map((t, i) => (
                  <span>{i > 0 ? ' · ' : ''}{t.toUpperCase()}</span>
                ))}
              </p>
              <h2 class="book-title">{book.title}</h2>
              <p class="book-meta">{book.author} · {book.year}</p>
              <p class="book-pitch">{book.pitch}</p>
              <span class="book-cta">Read my notes &rarr;</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<style>
  :root {
    --black: #161717;
    --green: #06402B;
    --white: #FFFFFF;
    --gray-700: #374151;
    --gray-500: #6B7280;
    --gray-200: #E5E7EB;
  }

  .filter-pill {
    border: 1px solid var(--gray-200);
    background: transparent;
    color: var(--gray-700);
    font-family: 'abril-display', serif;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.375rem 0.75rem;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }

  .filter-pill.active,
  .filter-pill:hover {
    background-color: var(--green);
    color: var(--white);
    border-color: var(--green);
  }

  .book-card-link {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem 0;
    text-decoration: none;
    align-items: flex-start;
    transition: background-color 0.2s;
  }

  .book-card-link:hover {
    background-color: rgba(6, 64, 43, 0.04);
  }

  .book-cover-wrap {
    flex-shrink: 0;
    width: 120px;
  }

  .book-cover {
    width: 120px;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    display: block;
    filter: grayscale(30%);
    transition: filter 0.3s;
  }

  .book-card-link:hover .book-cover {
    filter: grayscale(0%);
  }

  .book-info {
    flex: 1;
    min-width: 0;
  }

  .book-tags {
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--green);
    margin: 0 0 0.375rem 0;
    text-transform: uppercase;
  }

  .book-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--black);
    margin: 0 0 0.25rem 0;
    line-height: 1.3;
  }

  .book-meta {
    font-size: 0.875rem;
    color: var(--gray-500);
    margin: 0 0 0.625rem 0;
  }

  .book-pitch {
    font-size: 0.95rem;
    color: var(--gray-700);
    margin: 0 0 0.75rem 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .book-cta {
    font-size: 0.875rem;
    color: var(--green);
    text-decoration: underline;
    text-decoration-color: rgba(6, 64, 43, 0.3);
    text-underline-offset: 4px;
  }

  .book-card-link:hover .book-cta {
    text-decoration-color: var(--green);
  }
</style>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const cards = document.querySelectorAll<HTMLLIElement>('.book-card');

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      pills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      const tag = pill.dataset.tag ?? 'all';
      cards.forEach(card => {
        const tags = (card.dataset.tags ?? '').split(',');
        (card as HTMLElement).style.display = (tag === 'all' || tags.includes(tag)) ? '' : 'none';
      });
    });
  });
</script>