---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import homePage from '../data/homePage.json';
import { getImageUrl } from '../utils/imageUtils';

const allPosts = await getCollection('blog');

// Filter to only published posts
const publishedPosts = allPosts.filter(post => post.data.published !== false);

// Helper: extract first real paragraph from markdown body
function getBlurb(body: string): string {
  const stripped = body
    .replace(/^---[\s\S]*?---\n?/, '') // strip frontmatter if any leaked in
    .replace(/!\[.*?\]\(.*?\)/g, '')   // strip images
    .replace(/\[([^\]]+)\]\([^\)]+\)/g, '$1'); // flatten links
  const paragraphs = stripped.split(/\n\n+/).map(p => p.trim()).filter(p => p && !p.startsWith('#'));
  const first = paragraphs[0] || '';
  return first.length > 200 ? first.slice(0, 200).replace(/\s\S+$/, '') + '…' : first;
}

// Group posts by topic sections from CMS
const writingSections = homePage.writingSections || [];
const postsByTopic = writingSections.map(section => {
  const posts = publishedPosts
    .filter(post => post.data.topic === section.topic)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return {
    title: section.title,
    posts
  };
}).filter(section => section.posts.length > 0);

// Get posts that don't match any topic filter
const usedTopics = writingSections.map(section => section.topic);
const ungroupedPosts = publishedPosts
  .filter(post => !post.data.topic || !usedTopics.includes(post.data.topic))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title={`${homePage.hero.title}`} description={homePage.hero.subtitle}>
  <main class="w-full max-w-4xl mx-auto px-8 py-20">
    <!-- Profile Picture -->
    <div class="mb-6">
      <div class="w-32 h-32 md:w-40 md:h-40 overflow-hidden">
        <Image 
          src={getImageUrl(homePage.hero.image)} 
          alt={homePage.hero.imageAlt}
          width={160}
          height={160}
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
    </div>

    <!-- Hero / Intro -->
    <section class="mb-12">
      <h1 class="text-3xl md:text-4xl font-bold mb-2">{homePage.hero.title}</h1>
      <p class="text-lg md:text-xl mb-2 text-gray-700">
        {homePage.hero.subtitle}
      </p>
    </section>

    <!-- Challenge Quiz Section -->
    {homePage.challengeQuiz?.show && (
      <section class="mb-12">
        <p class="text-base md:text-lg mb-2 text-gray-700">
          <a href={homePage.challengeQuiz.url || '/30du'} class="group">
            <span>{homePage.challengeQuiz.linkText || homePage.challengeQuiz.text}</span>
          </a>
        </p>
      </section>
    )}

    <!-- Writing Sections by Topic -->
    {postsByTopic.map((section) => (
      <section class="mb-12">
        <h2 class="text-lg font-bold mb-6">{section.title}</h2>
        <div class="space-y-0">
          {section.posts.map((post) => (
            <div class="border-t border-gray-200 py-6">
              <a href={`/blog/${post.slug}`} class="group block">
                <h3 class="text-xl font-bold mb-3 group-hover:text-[#06402B] leading-snug">{post.data.title}</h3>
              </a>
              <p class="text-base text-gray-700 mb-4 leading-relaxed">{getBlurb(post.body)}</p>
              <div class="flex items-center gap-6">
                <a href={`/blog/${post.slug}`} class="text-sm font-semibold tracking-wide uppercase text-[#06402B] underline underline-offset-4">Read more</a>
                <span class="text-xs text-gray-400">
                  {post.data.date.toLocaleDateString('en-US', { 
                    month: 'short', 
                    day: 'numeric',
                    year: 'numeric' 
                  })}
                </span>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <!-- Ungrouped Posts (no topic match) -->
    {ungroupedPosts.length > 0 && (
      <section class="mb-12">
        <div class="space-y-0">
          {ungroupedPosts.map((post) => (
            <div class="border-t border-gray-200 py-6">
              <a href={`/blog/${post.slug}`} class="group block">
                <h3 class="text-xl font-bold mb-3 group-hover:text-[#06402B] leading-snug">{post.data.title}</h3>
              </a>
              <p class="text-base text-gray-700 mb-4 leading-relaxed">{getBlurb(post.body)}</p>
              <div class="flex items-center gap-6">
                <a href={`/blog/${post.slug}`} class="text-sm font-semibold tracking-wide uppercase text-[#06402B] underline underline-offset-4">Read more</a>
                <span class="text-xs text-gray-400">
                  {post.data.date.toLocaleDateString('en-US', { 
                    month: 'short', 
                    day: 'numeric',
                    year: 'numeric' 
                  })}
                </span>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Newsletter -->
    <section class="mt-18 mb-8">
      <p class="text-sm text-gray-700 mb-2">
        {homePage.newsletter.description}
      </p>
      <div id="newsletter-form"></div>
    </section>

    <!-- Connect Icons -->
    <section class="mt-8">
      <div class="flex flex-wrap gap-6 text-sm items-center justify-center">
        {homePage.cta.links.map((link: any) => {
          // Map link labels to icons
          let icon = '';
          let ariaLabel = '';
          
          if (link.label.includes('X')) {
            icon = '𝕏';
            ariaLabel = 'Follow on X';
          } else if (link.label.includes('LinkedIn')) {
            icon = 'in';
            ariaLabel = 'Connect on LinkedIn';
          } else if (link.label.includes('TikTok')) {
            icon = '♪';
            ariaLabel = 'Follow on TikTok';
          } else if (link.label.includes('Resume')) {
            icon = '↓';
            ariaLabel = 'Download Resume';
          }
          
          return link.url ? (
            <a 
              href={link.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group"
              aria-label={ariaLabel}
              title={ariaLabel}
            >
              <span class="text-sm group-hover:text-[#06402B]">{icon}</span>
            </a>
          ) : (
            <a 
              href={link.file} 
              download 
              class="group"
              aria-label={ariaLabel}
              title={ariaLabel}
            >
              <span class="text-sm group-hover:text-[#06402B]">{icon}</span>
            </a>
          );
        })}
      </div>
    </section>
  </main>
</Layout>