---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Stage AI - AI Home Design" description="Transform your space with AI-powered home design. Stage AI helps you visualize and design your perfect home.">
  <main class="w-full max-w-4xl mx-auto px-8 py-20">
    <div class="flex flex-col items-center text-center">
      <!-- App Icon -->
      <div class="mb-8">
        <img 
          src="/images/stageai-app-icon.png" 
          alt="Stage AI App Icon"
          class="w-32 h-32 md:w-40 md:h-40 object-contain mx-auto"
          loading="eager"
        />
      </div>

      <!-- App Name -->
      <h1 class="text-3xl md:text-4xl font-bold mb-4">Stage AI</h1>
      <p class="text-lg md:text-xl text-gray-700 mb-12">AI Home Design</p>

      <!-- Download Button -->
      <div class="mt-8">
        <button 
          class="px-8 py-4 bg-[#06402B] text-white text-base font-semibold cursor-pointer hover:bg-[#054a2e] transition-colors"
          disabled
          aria-label="Download Stage AI app"
        >
          Download Now
        </button>
      </div>

      <!-- Legal Links -->
      <div class="mt-12 pt-8 border-t border-gray-200 flex flex-wrap gap-6 justify-center">
        <a href="/stageai/privacy" class="group">
          <span class="text-base group-hover:text-[#06402B]">Privacy Policy</span>
        </a>
        <a href="/stageai/terms" class="group">
          <span class="text-base group-hover:text-[#06402B]">Terms of Service</span>
        </a>
      </div>

      <!-- Copyright and Contact Info -->
      <div class="mt-12 pt-8 border-t border-gray-200 text-sm text-gray-700 space-y-2">
        <p>© SwipeFeed LLC</p>
        <p>
          <a href="mailto:swipefeedlive@gmail.com" class="group">
            <span class="group-hover:text-[#06402B]">swipefeedlive@gmail.com</span>
          </a>
        </p>
        <p>7 Speare Pl, Boston, MA 02115</p>
      </div>
    </div>
  </main>
</Layout>

