---
import Layout from '../../layouts/Layout.astro';
import { readFile } from 'fs/promises';
import { marked } from 'marked';
import { fileURLToPath } from 'url';
import { dirname, join } from 'path';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);

// Read the terms markdown file
const termsMarkdown = await readFile(
  join(__dirname, '../../../stageai-terms.md'),
  'utf-8'
);

// Convert markdown to HTML
const termsHTML = await marked(termsMarkdown);
---

<Layout title="Terms of Service - Stage AI" description="Terms of Service for Stage AI - AI Home Design">
  <main class="w-full max-w-4xl mx-auto px-8 py-20">
    <!-- Back Link -->
    <div class="mb-8">
      <a href="/stageai" class="group">
        <span class="text-base group-hover:text-[#06402B]">← Back to Stage AI</span>
      </a>
    </div>

    <!-- Terms of Service Content -->
    <article>
      <header class="mb-12">
        <h1 class="text-2xl md:text-3xl font-bold mb-4">Terms of Service</h1>
      </header>

      <div class="prose prose-lg max-w-none" set:html={termsHTML} />
    </article>
  </main>
</Layout>

<style is:global>
  /* Prose styling for terms of service content */
  .prose {
    color: #161717;
    max-width: none;
  }

  .prose h1 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .prose h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .prose h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .prose h4 {
    font-size: 1rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .prose p {
    margin-bottom: 1.5rem;
    line-height: 1.8;
    font-size: 1rem;
  }

  .prose ul, .prose ol {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
    line-height: 1.8;
  }

  .prose ul {
    list-style-type: disc;
  }

  .prose ol {
    list-style-type: decimal;
  }

  .prose li {
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }

  .prose a {
    color: #06402B;
    text-decoration: underline;
    text-decoration-color: #06402B;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: opacity 0.2s ease;
  }

  .prose a:hover {
    opacity: 0.7;
  }

  .prose strong {
    font-weight: 700;
  }

  .prose em {
    font-style: italic;
  }

  .prose hr {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin: 3rem 0;
  }
</style>

